{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Animation Scene v2.1",
  "type": "object",
  "required": [
    "version",
    "canvas",
    "scenes"
  ],
  "properties": {
    "version": {
      "enum": [
        "2.0",
        "2.1"
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "width",
        "height",
        "duration"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 160,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 120,
          "maximum": 4096
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "grain_seed": {
          "type": "integer"
        },
        "font_path": {
          "type": "string"
        },
        "default_transition": {
          "$ref": "#/$defs/transition"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "narration": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "scene_index": {
                "type": "integer",
                "minimum": 0
              },
              "offset": {
                "type": "number",
                "minimum": 0
              },
              "pause_after": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "unverified",
              "disputed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url",
                "quote"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dimension": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?%$"
        }
      ]
    },
    "rect": {
      "type": "object",
      "properties": {
        "x": {
          "$ref": "#/$defs/dimension"
        },
        "y": {
          "$ref": "#/$defs/dimension"
        },
        "w": {
          "$ref": "#/$defs/dimension"
        },
        "h": {
          "$ref": "#/$defs/dimension"
        }
      }
    },
    "animation": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "fade",
            "slide",
            "pop",
            "draw",
            "move"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "easing": {
          "enum": [
            "linear",
            "out_cubic",
            "in_out",
            "out_back"
          ]
        },
        "from_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "from_x": {
          "type": "number"
        },
        "from_y": {
          "type": "number"
        },
        "to_x": {
          "type": "number"
        },
        "to_y": {
          "type": "number"
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": [
            "string",
            "number"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "text",
                "icon",
                "badge",
                "image"
              ]
            },
            "text": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            },
            "style": {
              "type": "object"
            },
            "asset": {
              "type": "string"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "text": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "style": {
          "type": "object"
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/animation"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "columns": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            }
          }
        },
        "items": {
          "type": "array"
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "column_weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "row_weights": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "padding": {
          "$ref": "#/$defs/dimension"
        },
        "gap": {
          "$ref": "#/$defs/dimension"
        },
        "header_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "grid_start": {
          "type": "number",
          "minimum": 0
        },
        "grid_duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cells_start": {
          "type": "number",
          "minimum": 0
        },
        "cell_duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stagger": {
          "type": "number",
          "minimum": 0
        },
        "order": {
          "enum": [
            "row",
            "column"
          ]
        },
        "line_start": {
          "type": "number",
          "minimum": 0
        },
        "line_duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "items_start": {
          "type": "number",
          "minimum": 0
        },
        "asset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "duration",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "transition_in": {
          "$ref": "#/$defs/transition"
        },
        "factual": {
          "type": "boolean"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "crossfade",
            "wipe_left",
            "slide_left",
            "cut"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}