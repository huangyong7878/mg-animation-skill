{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R2/R3 Formal Script and Storyboard Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approved_by",
    "approved_at",
    "revision",
    "project_id",
    "spec_id",
    "spec_revision",
    "script_sha256",
    "plan_sha256",
    "cues_sha256",
    "storyboard_sha256",
    "director_storyboard_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "approved"
    },
    "approved_by": {
      "type": "string",
      "minLength": 2
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cues_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "storyboard_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "director_storyboard_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
