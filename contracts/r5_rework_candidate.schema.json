{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R5 sampled-frame findings candidate, never a QA pass",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "spec_sha256",
    "implementation_commit",
    "video_sha256",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "const": "sampled_frames_only"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "video_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "shot_id",
          "expected",
          "observed",
          "fix_request",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "fix_request": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
