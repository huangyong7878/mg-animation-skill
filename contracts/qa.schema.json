{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Independent QA 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spec_id",
    "spec_revision",
    "spec_sha256",
    "implementation_commit",
    "reviewer",
    "decision",
    "checks",
    "findings",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_commit": {
      "type": "string",
      "minLength": 7
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "independent_context"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "independent_context": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "enum": [
        "pending",
        "pass",
        "rework",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shot_id",
          "requirement_id",
          "result",
          "evidence"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "needs_review",
              "fail"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "shot_id",
          "expected",
          "observed",
          "fix_request",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "fix_request": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
