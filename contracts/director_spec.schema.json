{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Director Specification 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spec_id",
    "revision",
    "approval",
    "creative",
    "narration",
    "output",
    "shots"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audience",
        "style",
        "core_message"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "core_message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "script_path",
        "alignment"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "locked"
          ]
        },
        "script_path": {
          "type": "string",
          "minLength": 1
        },
        "audio_path": {
          "type": "string",
          "minLength": 1
        },
        "timings_path": {
          "type": "string",
          "minLength": 1
        },
        "audio_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "alignment": {
          "enum": [
            "sentence",
            "word"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "duration_s"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 180
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_s",
          "duration_s",
          "beat_ids",
          "visual_description",
          "visual_contract",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "beat_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "visual_description": {
            "type": "string",
            "minLength": 1
          },
          "dynamic_model": {
            "type": "string"
          },
          "visual_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot_id",
              "visual_goal",
              "core_takeaway",
              "must_show",
              "render_mode",
              "silent_downgrade"
            ],
            "properties": {
              "shot_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
              },
              "visual_goal": {
                "type": "string",
                "minLength": 1
              },
              "core_takeaway": {
                "type": "string",
                "minLength": 1
              },
              "must_show": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "desc"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                    },
                    "desc": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "continuous_motion": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "from",
                    "through",
                    "to",
                    "desc"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                    },
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "through": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "desc": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "editorial": {
                "type": "object"
              },
              "render_mode": {
                "enum": [
                  "standard",
                  "custom"
                ]
              },
              "silent_downgrade": {
                "type": "boolean"
              }
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
