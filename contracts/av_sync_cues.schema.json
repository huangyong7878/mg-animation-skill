{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Stage C Narration ↔ Visual Event Cue Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spec_id",
    "spec_revision",
    "status",
    "event_source",
    "cues"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "event_source": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "start_event",
          "start_offsets_s",
          "end_event",
          "max_end_offset_s",
          "required_words",
          "expected_visual"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "start_event": {
            "type": "string",
            "minLength": 1
          },
          "start_offsets_s": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "end_event": {
            "type": "string",
            "minLength": 1
          },
          "max_end_offset_s": {
            "type": "number"
          },
          "required_words": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_visual": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
