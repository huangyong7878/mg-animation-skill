{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "status",
    "approval",
    "project_id",
    "spec_sha256",
    "source_implementation_commit",
    "approved_finding_ids",
    "findings",
    "execution_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "r4_rework_assignment"
    },
    "status": {
      "const": "approved_for_rework_only"
    },
    "approval": {
      "type": "object",
      "required": [
        "approved_by",
        "explicit_cli_authorization"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 2
        },
        "explicit_cli_authorization": {
          "const": true
        }
      }
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_implementation_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "approved_finding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "fix_request",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "fix_request": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_files",
        "max_runtime_seconds"
      ],
      "properties": {
        "allowed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_runtime_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        }
      }
    }
  }
}
