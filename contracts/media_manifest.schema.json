{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Media Artifact Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spec_id",
    "spec_revision",
    "spec_sha256",
    "implementation_commit",
    "attempt",
    "stage",
    "storage",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend"
      ],
      "properties": {
        "backend": {
          "enum": [
            "actions",
            "external",
            "local"
          ]
        },
        "artifact_name": {
          "type": "string",
          "minLength": 1
        },
        "run_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$"
        },
        "location_url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "video",
              "keyframe",
              "audio",
              "timings",
              "additional"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "backend": {
                "const": "actions"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "storage": {
            "required": [
              "backend",
              "artifact_name"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "backend": {
                "const": "external"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "storage": {
            "required": [
              "backend",
              "location_url"
            ]
          }
        }
      }
    }
  ]
}
