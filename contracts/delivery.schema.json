{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MG Executor Delivery 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "spec_id",
    "spec_revision",
    "spec_sha256",
    "implementation_commit",
    "attempt",
    "stage",
    "status",
    "artifacts",
    "checks",
    "deviations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "integer",
      "minimum": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_commit": {
      "type": "string",
      "minLength": 7
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "status": {
      "enum": [
        "prototype",
        "ready_for_qa",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_paths"
      ],
      "properties": {
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "video_path": {
          "type": "string",
          "minLength": 1
        },
        "audio_path": {
          "type": "string",
          "minLength": 1
        },
        "timings_path": {
          "type": "string",
          "minLength": 1
        },
        "keyframe_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result",
          "detail"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "reason",
          "approved"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "approved": {
            "type": "boolean"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
