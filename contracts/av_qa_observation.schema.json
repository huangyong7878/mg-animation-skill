{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R5 independent Stage C audiovisual model observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "audio_evaluated",
    "video_evaluated",
    "checks",
    "findings",
    "summary"
  ],
  "properties": {
    "decision": {
      "enum": [
        "pass",
        "pending",
        "rework"
      ]
    },
    "audio_evaluated": {
      "type": "boolean"
    },
    "video_evaluated": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "result",
          "timestamp_s",
          "heard_text",
          "visual_observation",
          "audio_verified",
          "video_verified",
          "reason"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "needs_review"
            ]
          },
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "heard_text": {
            "type": "string"
          },
          "visual_observation": {
            "type": "string",
            "minLength": 1
          },
          "audio_verified": {
            "type": "boolean"
          },
          "video_verified": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "severity",
          "timestamp_s",
          "expected",
          "observed",
          "fix_request"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "fix_request": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 12
    }
  }
}
